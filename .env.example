PORT=3000
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=inventario
# Certificado CA (PEM) si el MySQL exige SSL, p. ej. Aiven; vacío para MySQL local
DB_SSL_CA=

# Genera uno con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Primer administrador, se crea con npm run db:init si no hay usuarios
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@inventario.local
ADMIN_PASSWORD=
